    {
      "code": "CPT_001",
      "titre": "Comptes ouverts par agence et période",
      "description": "Comptes ouverts sur une période, par agence, avec leur type et leur statut.",
      "statut": "active",
      "version": 3,
      "requete_sql": [
        "SELECT a.nom_agence AS agence, c.num_compte AS num_compte, c.type_compte AS type_compte,",
        "       c.devise AS devise, c.date_ouverture AS date_ouverture, c.statut AS statut",
        "FROM amp_test.compte c",
        "JOIN amp_test.agence a ON a.agence_id = c.agence_id",
        "WHERE (:agence IS NULL OR c.agence_id = :agence)",
        "  AND c.date_ouverture BETWEEN :date_debut AND :date_fin",
        "  AND (:inclure_clotures = 1 OR c.statut <> 'CLOTURE')",
        "ORDER BY c.date_ouverture, c.num_compte"
      ],
      "parametres": [
        {
          "nom": "agence",
          "libelle": "Agence",
          "type": "liste",
          "obligatoire": true,
          "option_toutes": "— Toutes les agences —",
          "source": {
            "type": "requete",
            "requete_sql": [
              "SELECT agence_id AS valeur, nom_agence AS libelle",
              "FROM amp_test.agence",
              "ORDER BY nom_agence"
            ]
          }
        },
        {
          "nom": "date_debut",
          "libelle": "Date de début",
          "type": "date",
          "obligatoire": true
        },
        {
          "nom": "date_fin",
          "libelle": "Date de fin",
          "type": "date",
          "obligatoire": true,
          "defaut": "aujourd_hui",
          "apres_ou_egal": "date_debut"
        },
        {
          "nom": "inclure_clotures",
          "libelle": "Inclure les comptes clôturés",
          "type": "booleen",
          "obligatoire": false,
          "defaut": false
        }
      ],
      "colonnes": [
        {
