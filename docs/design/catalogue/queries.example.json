    {
      "code": "OPE_001",
      "titre": "Opérations par agence, période et montant",
      "description": "Opérations d'une période au-dessus d'un montant minimum, par agence et type de mouvement.",
      "statut": "active",
      "version": 1,
      "requete_sql": [
        "SELECT a.nom_agence AS agence, c.num_compte AS num_compte, o.date_operation AS date_operation,",
        "       o.type_operation AS type_operation, o.montant AS montant, o.libelle AS libelle, o.canal AS canal",
        "FROM amp_test.operation o",
        "JOIN amp_test.compte c ON c.compte_id = o.compte_id",
        "JOIN amp_test.agence a ON a.agence_id = c.agence_id",
        "WHERE (:agence IS NULL OR c.agence_id = :agence)",
        "  AND o.date_operation BETWEEN :date_debut AND :date_fin",
        "  AND o.montant >= :seuil_montant",
        "  AND (:type_operation IS NULL OR o.type_operation = :type_operation)",
        "ORDER BY o.date_operation, o.operation_id"
      ],
      "parametres": [
        {
          "nom": "agence",
          "libelle": "Agence",
          "type": "liste",
          "obligatoire": true,
