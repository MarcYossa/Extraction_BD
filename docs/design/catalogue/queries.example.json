    {
      "code": "CLI_001",
      "titre": "Recherche de clients",
      "description": "Clients par agence, statut et début du nom ou de la raison sociale.",
      "statut": "active",
      "version": 2,
      "requete_sql": [
        "SELECT cl.num_client AS num_client,",
        "       TRIM(cl.prenom || ' ' || cl.nom) AS nom_raison_sociale,",
        "       cl.segment_client AS segment_client, a.nom_agence AS agence, cl.statut AS statut",
        "FROM amp_test.client cl",
        "JOIN amp_test.agence a ON a.agence_id = cl.agence_id",
        "WHERE (:agence IS NULL OR cl.agence_id = :agence)",
        "  AND (:statut IS NULL OR cl.statut = :statut)",
        "  AND (:nom IS NULL OR UPPER(cl.nom) LIKE UPPER(:nom) || '%')",
        "ORDER BY cl.nom, cl.prenom, cl.num_client"
      ],
      "parametres": [
        {
          "nom": "agence",
          "libelle": "Agence",
          "type": "liste",
          "obligatoire": true,
          "option_toutes": "— Toutes les agences —",
          "source": {
            "type": "requete",
            "requete_sql": [
