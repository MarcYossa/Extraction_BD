    {
      "code": "CRT_001",
      "titre": "Crédits et engagements",
      "description": "Crédits et engagements octroyés sur une période, par agence, statut et type.",
      "statut": "brouillon",
      "version": 1,
      "requete_sql": [
        "SELECT a.nom_agence AS agence, cr.num_dossier AS num_dossier, cl.num_client AS num_client,",
        "       cr.type_engagement AS type_engagement, cr.montant_accorde AS montant_accorde, cr.encours AS encours,",
        "       cr.date_octroi AS date_octroi, cr.date_echeance AS date_echeance, cr.statut AS statut",
        "FROM amp_test.credit cr",
        "JOIN amp_test.agence a ON a.agence_id = cr.agence_id",
        "JOIN amp_test.client cl ON cl.client_id = cr.client_id",
        "WHERE (:agence IS NULL OR cr.agence_id = :agence)",
        "  AND cr.date_octroi BETWEEN :date_debut AND :date_fin",
        "  AND (:statut IS NULL OR cr.statut = :statut)",
        "  AND (:type_engagement IS NULL OR cr.type_engagement = :type_engagement)",
        "ORDER BY cr.date_octroi, cr.num_dossier"
